[Unit]
Description=LumenLink WebRTC signaling service
After=network.target

[Service]
Type=simple
User=lumenlink
WorkingDirectory=/opt/lumenlink/server_ubuntu
ExecStart=/usr/bin/java -jar /opt/lumenlink/server_ubuntu/target/lumenlink-signal-0.1.0-SNAPSHOT.jar
Restart=on-failure
Environment=LUMENLINK_SIGNAL_PORT=8080

[Install]
WantedBy=multi-user.target
